{
  "name": "marker-template-spec",
  "version": "0.0.0",
  "private": true,
  "description": "Development tooling for the MARKER Metadata Template Specification",
  "type": "module",
  "workspaces": [
    "implementations/typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace @staple-verse/marker-template-runtime",
    "validate": "npm run validate:schema && npm run validate:rules",
    "validate:jsonld": "node scripts/validate-jsonld.mjs",
    "validate:schema": "node scripts/validate-json-schema.mjs",
    "prevalidate:rules": "npm run build",
    "validate:rules": "node --test tests/conformance/*.test.mjs",
    "test": "npm run validate",
    "check": "npm run validate",
    "dev": "node scripts/generate-schema-module.mjs && tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsonld": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
