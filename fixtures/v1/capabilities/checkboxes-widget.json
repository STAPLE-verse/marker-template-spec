{
  "id": "checkboxes-widget",
  "description": "A multi-select list of enumerated strings presented as checkboxes.",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "methods": {
        "type": "array",
        "title": "Methods",
        "items": { "type": "string", "enum": ["survey", "interview", "observation"] },
        "uniqueItems": true
      }
    },
    "required": ["methods"]
  },
  "uiSchema": {
    "methods": { "ui:widget": "checkboxes" }
  },
  "instances": {
    "valid": [{ "label": "two selections", "data": { "methods": ["survey", "interview"] } }],
    "invalid": [
      { "label": "value outside enum", "data": { "methods": ["diary"] } },
      { "label": "duplicate selection", "data": { "methods": ["survey", "survey"] } }
    ]
  },
  "expectations": {
    "rjsfRendering": { "status": "pass", "reason": "Checkboxes is a standard RJSF widget for enum arrays." },
    "formStudioAuthoring": { "status": "pass", "reason": "Studio's Checkboxes (Multi-select) field writes this representation." },
    "stapleDeployment": { "status": "pass", "reason": "STAPLE forms built with the Checkboxes field use this representation." }
  }
}
