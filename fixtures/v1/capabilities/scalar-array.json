{
  "id": "scalar-array",
  "description": "A repeatable list of strings.",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "keywords": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "maxItems": 5,
        "uniqueItems": true
      }
    },
    "required": ["keywords"]
  },
  "uiSchema": {},
  "instances": {
    "valid": [{ "label": "unique strings", "data": { "keywords": ["FAIR", "metadata"] } }],
    "invalid": [
      { "label": "duplicate strings", "data": { "keywords": ["FAIR", "FAIR"] } },
      { "label": "empty array", "data": { "keywords": [] } },
      { "label": "too many items", "data": { "keywords": ["one", "two", "three", "four", "five", "six"] } },
      { "label": "empty string item", "data": { "keywords": [""] } }
    ]
  },
  "expectations": {
    "rjsfRendering": { "status": "pass", "reason": "RJSF renders scalar arrays." },
    "formStudioAuthoring": { "status": "pass", "reason": "Studio provides a constrained string-array editor without allowing item-type conversion." },
    "formStudioPreservation": { "status": "pass", "reason": "String item schemas and array constraints survive visual edits without information loss." },
    "stapleDeployment": { "status": "pass", "reason": "The research-data built-in contains an array of strings." }
  }
}
