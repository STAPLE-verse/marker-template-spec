{
  "id": "conditional-if-then",
  "description": "A field that becomes required when a controlling value is selected.",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "access": { "type": "string", "enum": ["open", "restricted"] }
    },
    "required": ["access"],
    "allOf": [
      {
        "if": { "properties": { "access": { "const": "restricted" } } },
        "then": {
          "properties": { "restrictionReason": { "type": "string", "minLength": 1 } },
          "required": ["restrictionReason"]
        }
      }
    ]
  },
  "uiSchema": {
    "ui:order": ["access", "restrictionReason"],
    "restrictionReason": {
      "ui:widget": "textarea",
      "ui:placeholder": "Explain the restriction"
    }
  },
  "instances": {
    "valid": [{ "label": "restricted with reason", "data": { "access": "restricted", "restrictionReason": "Embargo" } }],
    "invalid": [{ "label": "restricted without reason", "data": { "access": "restricted" } }]
  },
  "expectations": {
    "rjsfRendering": { "status": "pass", "reason": "RJSF and AJV evaluate draft-07 conditionals." },
    "formStudioAuthoring": { "status": "unsupported", "reason": "Studio reports allOf rules as non-editable while preserving them unchanged." },
    "formStudioPreservation": { "status": "pass", "reason": "Conditional branches, conditional-only UI paths, and ui:order entries survive unrelated visual edits." },
    "stapleDeployment": { "status": "pass", "reason": "This pattern occurs in the data and document built-ins." }
  }
}
