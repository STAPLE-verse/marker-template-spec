{
  "id": "numeric-constraints",
  "description": "Integer and number inputs with standard numeric constraints.",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "count": { "type": "integer", "minimum": 1 },
      "ratio": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.1 }
    },
    "required": ["count", "ratio"]
  },
  "uiSchema": {},
  "instances": {
    "valid": [{ "label": "values within bounds", "data": { "count": 2, "ratio": 0.5 } }],
    "invalid": [{ "label": "values outside bounds", "data": { "count": 0, "ratio": 1.5 } }]
  },
  "expectations": {
    "rjsfRendering": { "status": "pass", "reason": "Native integer and number fields." },
    "formStudioAuthoring": { "status": "pass", "reason": "Studio exposes the represented numeric constraints." },
    "stapleDeployment": { "status": "pass", "reason": "The deployed RJSF validator supports the constraints." }
  }
}
