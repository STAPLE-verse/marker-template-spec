          "valueKind": "literal"
        },
        {
          "fieldPointer": "/properties/tags",
          "predicate": "https://schema.org/keywords",
          "valueKind": "literal"
        },
        {
          "fieldPointer": "/properties/omitted",
          "predicate": "https://schema.org/description",
          "valueKind": "literal"
        }
      ]
    }
  },
